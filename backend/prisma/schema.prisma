generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(100)
  email        String       @unique @db.VarChar(190)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  role         String       @default("user") @db.VarChar(10)
  avatarUrl    String?      @map("avatar_url") @db.VarChar(500)
  bio          String?      @db.VarChar(500)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamp(6)
  reviews      Review[]
  comments     Comment[]
  likes        ReviewLike[]
  favorites    Favorite[]

  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Review {
  id         Int          @id @default(autoincrement())
  userId     Int          @map("user_id")
  title      String       @db.VarChar(180)
  restaurant String       @db.VarChar(180)
  location   String?      @default("") @db.VarChar(180)
  category   String?      @default("อื่น ๆ") @db.VarChar(80)
  rating     Int          @db.SmallInt
  body       String       @db.Text
  imageUrl   String?      @map("image_url") @db.VarChar(500)
  viewCount  Int          @default(0) @map("view_count")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime     @default(now()) @map("updated_at") @db.Timestamp(6)
  author     String?      @db.VarChar(255)
  likeCount  Int?         @default(0) @map("like_count")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   Comment[]
  likes      ReviewLike[]
  favorites  Favorite[]

  @@index([createdAt], map: "idx_reviews_created")
  @@index([rating], map: "idx_reviews_rating")
  @@index([category], map: "idx_reviews_category")
  @@index([restaurant], map: "idx_reviews_restaurant")
  @@map("reviews")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(80)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("categories")
}

model Restaurant {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(180)
  address    String?  @db.VarChar(500)
  district   String?  @db.VarChar(120)
  province   String?  @db.VarChar(120)
  phone      String?  @db.VarChar(30)
  priceLevel String?  @default("ปานกลาง") @map("price_level") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([name], map: "idx_restaurants_name")
  @@index([province], map: "idx_restaurants_province")
  @@map("restaurants")
}

model Comment {
  id          Int      @id @default(autoincrement())
  reviewId    Int      @map("review_id")
  userId      Int      @map("user_id")
  commentText String   @map("comment_text") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt], map: "idx_comments_review")
  @@map("comments")
}

model ReviewLike {
  id        Int      @id @default(autoincrement())
  reviewId  Int      @map("review_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId], map: "uq_like_user_review")
  @@index([reviewId], map: "idx_likes_review")
  @@map("review_likes")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  reviewId  Int      @map("review_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId], map: "uq_favorite_user_review")
  @@index([userId], map: "idx_favorites_user")
  @@map("favorites")
}

model ContactMessage {
  id                 Int       @id @default(autoincrement())
  name               String    @db.VarChar(100)
  email              String    @db.VarChar(190)
  subject            String    @db.VarChar(180)
  message            String    @db.Text
  trackingCodeHash   String?   @unique(map: "contact_messages_tracking_code_hash_key") @map("tracking_code_hash") @db.Char(64)
  trackingRecoveryHash String? @unique(map: "contact_messages_tracking_recovery_hash_key") @map("tracking_recovery_hash") @db.Char(64)
  trackingRecoveryExpiresAt DateTime? @map("tracking_recovery_expires_at") @db.Timestamp(6)
  status             String    @default("pending") @db.VarChar(20)
  attachmentFilename String?   @map("attachment_filename") @db.VarChar(100)
  adminReply         String?   @map("admin_reply") @db.Text
  repliedAt          DateTime? @map("replied_at") @db.Timestamp(6)
  replyEmailSentAt   DateTime? @map("reply_email_sent_at") @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([status, createdAt], map: "idx_contact_status")
  @@map("contact_messages")
}

model Contact {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  email     String    @db.VarChar(255)
  type      String    @db.VarChar(100)
  subject   String    @db.VarChar(255)
  message   String    @db.Text
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("contacts")
}
